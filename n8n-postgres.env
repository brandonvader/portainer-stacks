# Copy these into Portainer's stack "Environment variables" box (Advanced mode / .env editor)
# when you create the stack. Fill in real values first — do not deploy with the placeholders below.

# Hostname n8n will be reached at from the outside. Must match the Proxy Host
# you create in Nginx Proxy Manager (e.g. n8n.yourdomain.com).
N8N_HOST=<FQDN Here>

# IANA timezone, e.g. America/New_York, Europe/London, UTC
TIMEZONE=America/Los_Angeles

# Postgres credentials — change these before deploying.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=<Generate Password>
POSTGRES_DB=n8n

# Encryption key n8n uses to encrypt stored credentials.
# Generate one with:  openssl rand -hex 24
# IMPORTANT: set this explicitly and never change it after first deploy —
# changing it makes all previously stored credentials unreadable. Back this value up.
N8N_ENCRYPTION_KEY=<Generate Key>
